{
    "name": "RL_cyclic_permeable_soluble_peptides",
    "model_type": "mol2mol",
    "model_path": "./data/models/generative_model.ckpt",
    "input_sequence": "N[C@@H](CC1(NC(=O)c2ncncc2Br)CC1)C(=O)|N1[C@H](CCC1)C(=O)|N1[C@@H](CCC1)C(=O)|N(C)[C@@H](CCCNC(=N)N)C(=O)|N[C@@H](c1cn(CC(=O)OCC)nc1C1CCCC1)C(=O)|N[C@@H](Cc1ccc(O)cc1)C(=O)|N[C@@H](C(C)C)C(=O)|N(C)CC(=O)|N[C@@H](C[C@@H]1C[C@@]21CCCC12CCCC1)C(=O)|N[C@@H](CCCNC(=N)N)C(=O)|N[C@H](CC(C)C)C(=O)|N[C@@H](CCCNC(=N)N)C(=O)O",
    "learning_configuration": {
        "warmup_steps": 5,
        "routing_steps": 5,
        "evolving_steps": 5,
        "optimizing_steps_before_evolve": 5,
        "num_mutations": 2,
        "num_top_monomers": 5,
        "evolve_positions": [],
        "batch_size": 32,
        "score_multiplier": 80,
        "learning_rate": 5e-05,
        "distance_threshold": -20
    },
    "scoring_function": {
        "scoring_function": "geometric_mean",
        "scoring_components": [
            {
                "name": "logp",
                "weight": 1,
                "specific_parameters": {
                    "transformation": {
                        "transformation_type": "sigmoid",
                        "low": 0,
                        "high": 0.5,
                        "k": 0.5
                    }
                }
            }
        ]
    },
    "logging": {
        "logging_path": "./output/logging",
        "result_path": "./output/result"
    },
    "diversity_filter": {
        "name": "IdenticalMurckoScaffold",
        "score_threshold": 0.4,
        "bucket_size": 25,
        "similarity_threshold": 0.4,
        "penalty": 0.5
    }
}